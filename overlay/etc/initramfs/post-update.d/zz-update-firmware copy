#!/bin/sh 

set -e

version="$1"

# Passing the kernel version is required
if [ -z "${version}" ]; then
	echo "ubuntu-rockchip: ${DPKG_MAINTSCRIPT_PACKAGE:-kernel package} did not pass a version number"
	exit 2
fi

# Do not run inside an LXC container or chroot
if systemd-detect-virt --quiet --container || systemd-detect-virt --quiet --chroot; then
    exit 0
fi

# Determine the boot partition target directory
# Priority: /boot/firmware/ > /boot/ > auto-mount p1
boot_target=""

# 1. Check if /boot/firmware/ is already a mounted partition
if mountpoint -q /boot/firmware/ 2>/dev/null; then
    boot_target="/boot/firmware"
fi

# 2. Check if /boot is a mounted partition (not tmpfs/overlay)
if [ -z "${boot_target}" ]; then
    boot_src=$(findmnt -n -o SOURCE /boot 2>/dev/null)
    if [ -n "${boot_src}" ] && [ -d "/boot/dtb" ]; then
        boot_target="/boot"
    fi
fi

# 3. Fallback: try to find and mount the first partition as firmware
if [ -z "${boot_target}" ]; then
    partition_root=$(findmnt -n -o SOURCE /)
    partition_pkname="$(lsblk -no pkname "${partition_root}")"
    partition_char=$(if printf "%s" "${partition_pkname}" | tail -c 1 | grep -q '^[0-9]*$'; then echo p; fi)

    if [ "$(findmnt -M /boot/firmware/ -n -o SOURCE)" != "/dev/${partition_pkname}${partition_char}1" ]; then
        mkdir -p /boot/firmware/
        umount -lf /boot/firmware/ 2> /dev/null || true
        if mount "/dev/${partition_pkname}${partition_char}1" /boot/firmware/ 2>/dev/null; then
            boot_target="/boot/firmware"
        else
            echo "Warning: could not mount boot partition, skipping firmware update"
            exit 0
        fi
    else
        boot_target="/boot/firmware"
    fi
fi

# Update dtbs, initrd, and kernel in the boot target
if [ -d "/usr/lib/linux-image-${version}" ]; then
    rm -rf "${boot_target}/dtbs/"
    cp -r "/usr/lib/linux-image-${version}/." "${boot_target}/dtbs/"
else
    echo "Note: /usr/lib/linux-image-${version} not found, skipping dtb update"
fi
[ -f "/boot/initrd.img-${version}" ] && cp "/boot/initrd.img-${version}" "${boot_target}/initrd.img" || true
[ -f "/boot/vmlinuz-${version}" ] && cp "/boot/vmlinuz-${version}" "${boot_target}/vmlinuz" || true

sync
