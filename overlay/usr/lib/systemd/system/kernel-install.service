[Unit]
Description=Install linux-image deb on first boot
ConditionPathExists=!/boot/.linux-image-installed
After=local-fs.target

[Service]
Type=oneshot
ExecStart=dpkg -i /usr/local/linux-image.deb
ExecStart=touch /boot/.linux-image-installed
ExecStartPost=systemctl disable kernel-install.service
RemainAfterExit=yes
# 内核 deb 安装（含 update-initramfs）进度打到串口控制台，便于观察首启
StandardOutput=journal+console
StandardError=journal+console

[Install]
WantedBy=local-fs.target