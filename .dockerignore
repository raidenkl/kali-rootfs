# =============================================================================
#  .dockerignore — 控制 build context 体积与缓存失效范围
# =============================================================================
#  Docker 会把整个 context 发给 daemon；本项目根目录下有些东西
#  完全不该进 context（会拖慢构建、并且会打穿 COPY 层的缓存）。
# =============================================================================

# ---- 构建产物 / 输出 --------------------------------------------------------
build/rootfs/
build/.build-state/
build/*.tar
build/*.tar.*
build/*.img
build/*.xz
build/*.zst
images/
out/
*.img
*.img.xz
*.img.sha256
*.rootfs.tar
*.rootfs.tar.*

# ---- 版本控制与 CI ---------------------------------------------------------
.git/
.gitignore
.github/
.gitlab-ci.yml
.gitattributes

# ---- 编辑器 / 临时文件 -----------------------------------------------------
.vscode/
.idea/
*.swp
*.swo
*~
*.bak
*.orig
*.rej
.DS_Store
Thumbs.db

# ---- 文档（不参与构建，避免无关改动打穿缓存） -----------------------------
*.md
!README.md
docs/

# ---- 本地构建日志 ----------------------------------------------------------
*.log
build/docker/out/

# ---- 保留必需内容 ----------------------------------------------------------
# 下面这些是构建真正需要的，不能被 ignore：
#   overlay/  overlay-firmware/  packages/
#   config/   scripts/           build/docker/
!overlay/
!overlay-firmware/
!packages/
!config/
!scripts/
!build/docker/
