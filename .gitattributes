# 强制 shell 脚本与 Dockerfile 在仓库中保存为 LF，
# 避免在 Windows 上编辑后被转成 CRLF，导致 Linux 侧报
#   bad interpreter: /bin/bash^M
*.sh        text eol=lf
Dockerfile  text eol=lf
*.conf      text eol=lf
*.uEnv      text eol=lf
*.rules     text eol=lf
*.service   text eol=lf
*.yaml      text eol=lf
*.yml       text eol=lf
*.md        text eol=lf

# 二进制文件不做换行符转换
*.deb       binary
*.bin       binary
*.elf       binary
*.img       binary
*.png       binary
*.dtb       binary
*.dtbo      binary
